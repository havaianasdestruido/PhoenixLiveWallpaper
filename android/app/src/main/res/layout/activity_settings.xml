<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings screen for the wallpaper. Every @+id here is mirrored by
    source/phoenix/wallpaper/RId.hx, and phoenix.wallpaper.SettingsActivity wires
    the widgets to Prefs. Static text lives in strings.xml; the labels that change
    (interval, crossfade, dim, scaling, "now showing") are set from Haxe.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card"
            android:padding="12dp"
            android:text="@string/now_playing"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <!-- ==== slideshow ==== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_slideshow"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intervalLabel"
            android:labelFor="@+id/intervalSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/interval_label"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/intervalSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="115"
            android:progress="15" />

        <TextView
            android:id="@+id/fadeLabel"
            android:labelFor="@+id/fadeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/fade_label"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/fadeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="80"
            android:progress="18" />

        <Switch
            android:id="@+id/shuffleSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="6dp"
            android:text="@string/shuffle_switch"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <!-- ==== look ==== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_look"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mode_label"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_auto"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/modeCover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_cover"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/modeFit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_fit"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/modeStretch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_stretch"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/dimLabel"
            android:labelFor="@+id/dimSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/dim_label"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/dimSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="90"
            android:progress="0" />

        <!-- ==== input ==== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_input"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/tapSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:text="@string/tap_switch"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/parallaxSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/parallax_switch"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <!-- ==== playlist ==== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_header"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlistList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/apply_button"
            android:textColor="@color/settings_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/footer"
            android:textColor="@color/muted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
